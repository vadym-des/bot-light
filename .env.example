# Токен Telegram бота (отримати у @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Інтервал перевірки сайту в секундах (за замовчуванням: 60)
CHECK_INTERVAL_SECONDS=60

# Параметри адреси: Бережани (Бережанська ОТГ), вул. Героїв Майдану, буд. 2-А
OTG_ID=17
OTG_NAME=Бережанська ОТГ

CITY_ID=136
CITY_NAME=Бережани

STREET_ID=1663
STREET_NAME=вул. Героїв Майдану

BUILDING_NAME=2-А
CHER_GPV=2.1

# Часовий пояс
TIMEZONE=Europe/Kyiv

# Шлях до бази даних SQLite (використовується локально, коли DATABASE_URL порожній)
DB_PATH=bot_data.db

# Постійна БД PostgreSQL (наприклад, Supabase) — рекомендовано для Render Free Tier.
# Для Supabase на Render використовуйте Session pooler або Transaction pooler URI (IPv4 сумісний), а не Direct.
# Якщо порожньо — використовується локальний SQLite (DB_PATH).
DATABASE_URL=
# Окрема PostgreSQL-схема для ізоляції таблиць бота від інших проєктів у тій самій БД
DB_SCHEMA=bot_light

# Опціональні налаштування (за потреби)
# Chat ID власника для початкової автопідписки при старті
DEFAULT_CHAT_ID=
# Username бота (без @) для кнопки "Поділитися з сусідом" (якщо порожньо — визначається автоматично через get_me)
BOT_USERNAME=
# Зовнішній URL сервісу на Render (якщо задано — вмикається self-ping keep-alive)
RENDER_EXTERNAL_URL=
# Render Deploy Hook URL для ручного оновлення/перезапуску через /restart або кнопку в налаштуваннях
RENDER_DEPLOY_HOOK_URL=
# Порт для HTTP healthcheck-сервера
PORT=10000

# Інтеграція з AllpowersBar (фактичний стан мережі 220V зі станції)
# Секретний Bearer-токен для POST /api/station-state (якщо порожньо — прийом стану вимкнено)
STATION_API_TOKEN=
# Час актуальності сигналу зі станції в секундах (після спливу бот повертається до графіка ТОЕ)
STATION_STATE_TTL_SECONDS=180
# Затримка підтвердження зміни стану мережі в секундах (захист від секундного мигання)
STATION_DEBOUNCE_SECONDS=20
